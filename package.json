{
  "name": "mzizi",
  "version": "1.0.0",
  "private": true,
  "description": "Mzizi — an open-architecture project of the Bundu Foundation. Open 3D frontend architecture, component registry, and MCP server, operated and developed by Nyuchi.",
  "homepage": "https://mzizi.dev",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "dev": "next dev --port ${PORT:-11736}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start --port ${PORT:-11736}",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packages": "pnpm --filter \"./packages/*\" test",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "pnpm --filter \"./packages/*\" typecheck",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "registry:normalize": "tsx scripts/normalize-registry.ts",
    "registry:verify": "tsx scripts/normalize-registry.ts --check",
    "tokens:sync": "tsx scripts/sync-tokens.ts",
    "tokens:verify": "tsx scripts/sync-tokens.ts --check",
    "lint:colors": "tsx scripts/lint-colors.ts",
    "prepare": "husky",
    "audit:check": "pnpm audit --audit-level=moderate --ignore-registry-errors",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,yaml,yml}\" --ignore-path .prettierignore",
    "lint:md": "markdownlint-cli2",
    "lint:yaml": "yamllint .",
    "lint:json": "node -e \"const{execSync}=require('child_process');const fs=require('fs');const files=execSync(\\\"git ls-files '*.json' ':!pnpm-lock.yaml'\\\").toString().trim().split('\\n').filter(Boolean);let fail=0;for(const f of files){try{JSON.parse(fs.readFileSync(f,'utf8'))}catch(e){console.error('INVALID JSON:',f,e.message);fail=1}}process.exit(fail)\"",
    "check": "pnpm format:check && pnpm lint && pnpm lint:colors && pnpm lint:md && pnpm lint:json && pnpm typecheck && pnpm test && pnpm audit:check && pnpm registry:validate && pnpm registry:verify && pnpm tokens:verify && pnpm build",
    "registry:validate": "node scripts/validate-registry.mjs",
    "doctrine:extract": "tsx scripts/extract-doctrine.ts",
    "doctrine:verify": "tsx scripts/extract-doctrine.ts --check",
    "props:extract": "tsx scripts/extract-props.ts",
    "props:verify": "tsx scripts/extract-props.ts --check",
    "samples:push": "tsx scripts/push-samples.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.5.7",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@next/mdx": "^16.2.12",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-menubar": "1.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.110.9",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "2.0.1",
    "autoprefixer": "^10.5.4",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "dompurify": "^3.4.13",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.10.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "sanitize-html": "^2.17.6",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "0.23.2",
    "mongodb": "^7.5.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{ts,tsx,js,mjs,json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.15.2",
      "hono": "^4.12.34",
      "@hono/node-server": "^2.0.5",
      "express-rate-limit": "^8.3.2",
      "flatted": "^3.4.2",
      "path-to-regexp": "^8.4.2",
      "@xmldom/xmldom": "^0.9.10",
      "uuid": "^14.0.0",
      "vite": "^7.3.5",
      "esbuild": "^0.28.1",
      "@babel/core": "^7.29.6",
      "undici": "^7.28.0",
      "linkify-it": "^5.0.2",
      "yaml": "^2.8.3",
      "lodash-es": "^4.18.1",
      "micromatch>picomatch": "^2.3.2",
      "tinyglobby>picomatch": "^4.0.4",
      "minimatch>brace-expansion": "^5.0.9",
      "postcss": "^8.5.18",
      "dompurify": "^3.4.0",
      "sanitize-html": "^2.17.4",
      "js-yaml": "^4.3.1",
      "markdown-it": "^14.2.0",
      "fast-uri": "^3.1.5",
      "ip-address": "^10.1.1",
      "ws": "^8.20.1",
      "brace-expansion": "^5.0.9",
      "sharp": "^0.35.0",
      "nanoid": "^3.3.17"
    }
  }
}

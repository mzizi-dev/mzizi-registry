---
/**
 * StatTiles — one bordered row of equal StatTiles with hairline dividers,
 * as a description list (each tile is a "label, value" group). One column
 * on phones, two from `sm`, and `columns` (default 4) from `lg`.
 */
interface Props {
  /** Accessible name of the row, e.g. "Activity this week". */
  label?: string;
  columns?: 2 | 3 | 4 | 5 | 6;
}
const { label, columns = 4 } = Astro.props;
const lg = { 2: "lg:grid-cols-2", 3: "lg:grid-cols-3", 4: "lg:grid-cols-4", 5: "lg:grid-cols-5", 6: "lg:grid-cols-6" }[columns];
---

<div class="overflow-hidden rounded-md border border-border bg-card" data-slot="stat-tiles">
  <dl aria-label={label} class={`-mt-px -ml-px grid grid-cols-1 sm:grid-cols-2 ${lg} *:rounded-none *:border-0 *:border-t *:border-l *:border-border`}>
    <slot />
  </dl>
</div>

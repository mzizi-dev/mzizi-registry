---
/**
 * DetailHero — the top of the page for ONE item reached from a Discover page
 * (an article, an event, a public circle, a place): the breadcrumb, an
 * eyebrow, the page's one <h1>, when and where (for an event or an article's
 * date), a lead, the actions, and the item's image or media.
 *
 * The image is the item's own, so it loads eagerly (it is likely the
 * largest paint); decorative by default, since the title names the item.
 * The `media` slot replaces it (a map, a weather figure, a gallery). With
 * media the hero is two columns from 64rem, text first; without, one.
 *
 * Text props that may arrive empty from a server-filled shell hide
 * themselves (`empty:hidden`), so a `{{placeholder}}` that fills to "" leaves
 * no gap.
 *
 * Mzizi Discover Standard (contracts/discover/detail-hero).
 */
import { cn } from "./ui-utils";
import Icon from "./site-icon.astro";

interface Props {
  /** The item's name: the page's only <h1>. */
  title: string;
  /** The service, source or category, e.g. "Mukoko Events". */
  eyebrow?: string;
  /** One or two sentences. */
  lead?: string;
  /** An image URL; replaced by the `media` slot. */
  image?: string;
  imageAlt?: string;
  /** ISO 8601 for <time datetime>; `dateLabel` is what reads. */
  datetime?: string;
  dateLabel?: string;
  /** Venue, town or region. */
  place?: string;
}
const { title, eyebrow, lead, image, imageAlt = "", datetime, dateLabel, place } = Astro.props;
const hasMedia = Astro.slots.has("media") || image !== undefined;
const hasWhen = dateLabel !== undefined || place !== undefined;
---

<header class="border-b border-border bg-background" data-slot="detail-hero" data-media={hasMedia ? "true" : "false"}>
  <div class={cn("container-custom grid gap-8 py-10 md:py-14", hasMedia && "lg:grid-cols-2 lg:items-center lg:gap-12")}>
    <div class="min-w-0">
      {
        Astro.slots.has("breadcrumb") && (
          <div class="mb-4">
            <slot name="breadcrumb" />
          </div>
        )
      }
      {eyebrow !== undefined && <p class="eyebrow empty:hidden">{eyebrow}</p>}
      <h1 class="max-w-4xl font-serif text-h1 text-balance">{title}</h1>
      {
        hasWhen && (
          <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-body font-semibold text-foreground" data-slot="detail-hero-when">
            {dateLabel !== undefined && (
              <li class="inline-flex items-center gap-2">
                <Icon name="calendar" class="shrink-0 text-muted-foreground" />
                <time datetime={datetime} class="empty:hidden">{dateLabel}</time>
              </li>
            )}
            {place !== undefined && (
              <li class="inline-flex items-center gap-2">
                <Icon name="map-pin" class="shrink-0 text-muted-foreground" />
                <span class="empty:hidden">{place}</span>
              </li>
            )}
          </ul>
        )
      }
      {lead !== undefined && <p class="mt-4 max-w-2xl text-body-lg text-muted-foreground text-pretty empty:hidden">{lead}</p>}
      {
        Astro.slots.has("actions") && (
          <div class="mt-6">
            <slot name="actions" />
          </div>
        )
      }
    </div>
    {
      Astro.slots.has("media") ? (
        <div class="min-w-0 overflow-hidden rounded-lg bg-muted" data-slot="detail-hero-media">
          <slot name="media" />
        </div>
      ) : (
        image !== undefined && (
          <img src={image} alt={imageAlt} width="1200" height="675" decoding="async" class="aspect-video w-full rounded-lg bg-muted object-cover" data-slot="detail-hero-media" />
        )
      )
    }
  </div>
</header>

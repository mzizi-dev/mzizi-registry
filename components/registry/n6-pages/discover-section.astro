---
/**
 * DiscoverSection — one band of a Discover page: an eyebrow, a heading, a
 * line of description and a "See all" link, over its content (a
 * ResultGrid, CategoryChips, or anything else). A named region, labelled by
 * its heading. A featured rail is a DiscoverSection holding a ResultGrid.
 *
 * `state="empty"` hides the whole band (heading included), for a section
 * whose data came back empty; a server-filled shell may pass a placeholder.
 *
 * Mzizi Discover Standard (contracts/discover/discover-section).
 */
import { cn } from "./ui-utils";
import { buttonVariants } from "./ui-variants";

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  /** Where "See all" goes; no link without it. */
  seeAllHref?: string;
  /** Say what "all" is, e.g. "See every circle" (default "See all"). */
  seeAllLabel?: string;
  /** `muted` puts the band on the secondary surface. */
  tone?: "default" | "muted";
  space?: "default" | "tight";
  /** Heading level (default 2). */
  level?: 2 | 3;
  /** The section's id; its heading is `<id>-title`. Unique per page. */
  id: string;
  /** "ok" or "empty": empty hides the band (a server-filled shell may pass a placeholder). */
  state?: string;
}
const { title, eyebrow, description, seeAllHref, seeAllLabel = "See all", tone = "default", space = "default", level = 2, id, state = "ok" } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
const titleId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={titleId}
  class={cn(space === "tight" ? "py-12 md:py-16" : "py-16 md:py-24", tone === "muted" && "bg-secondary", "data-[state=empty]:hidden")}
  data-slot="discover-section"
  data-tone={tone}
  data-state={state}
>
  <div class="container-custom">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        {eyebrow !== undefined && <p class="eyebrow empty:hidden">{eyebrow}</p>}
        <Heading id={titleId} class={cn("font-serif text-balance", level === 2 ? "text-h2" : "text-h3")}>{title}</Heading>
        {description !== undefined && <p class="mt-3 text-body-lg text-muted-foreground text-pretty empty:hidden">{description}</p>}
      </div>
      {
        seeAllHref && (
          <a href={seeAllHref} class={buttonVariants({ variant: "outline", size: "sm" })}>
            {seeAllLabel}
          </a>
        )
      }
    </div>
    <slot />
  </div>
</section>

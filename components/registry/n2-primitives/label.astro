---
/**
 * Label — a native <label>, pure Astro. Classes are `labelClasses`.
 */
import { cn } from "./ui-utils";
import { labelClasses } from "./ui-variants";

interface Props {
  for: string;
  class?: string;
}
const { for: htmlFor, class: extra } = Astro.props;
---

<label data-slot="label" for={htmlFor} class={cn(labelClasses, extra)}><slot /></label>

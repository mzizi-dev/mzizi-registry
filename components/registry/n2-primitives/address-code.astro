---
/**
 * AddressCode — a Kweli address code as a chip: the code in the mono face, and a link
 * that opens the address (directions, the entrance, who to call on arrival).
 *
 * The code is the permanent, shareable identity of an address (`NYU-7K2Q`, Kweli Address
 * RFC v0.1). It is set in `font-mono` with the tracking a reader needs to copy it by eye
 * or read it down a phone line, and it is a `<code>` so a screen reader reads it as one
 * token. With `href` the chip carries a link; without it the chip is the code alone.
 * The link's visible text is short ("Open"), and its accessible name says what it opens
 * ("Open address NYU-7K2Q"), so a list of chips is not a list of identical "Open" links.
 *
 * Colour is semantic only: the chip is `bg-card` on a `border`, the link is `--primary`,
 * so Kweli's brand overlay (malachite) colours it and nothing here names a mineral.
 *
 * The React build is `address-code.tsx`; both keep `contracts/ui/address-code`.
 */
import { cn } from "./ui-utils";

interface Props {
  /** The address code, e.g. "NYU-7K2Q". */
  code: string;
  /** Where the code resolves, e.g. "https://kweli.mukoko.com/a/NYU-7K2Q". No link without it. */
  href?: string;
  /** The link's visible text. */
  linkLabel?: string;
  /** What the code is, for assistive technology. */
  label?: string;
  class?: string;
}

const { code, href, linkLabel = "Open", label = "Address", class: className } = Astro.props;
---

<span
  data-slot="address-code"
  data-portal="https://mzizi.dev/components/address-code"
  class={cn("inline-flex min-h-11 max-w-full min-w-0 items-center gap-1 rounded-full border border-border bg-card ps-4 pe-1 text-foreground", !href && "pe-4", className)}
>
  <span class="sr-only">{label}</span>
  <code data-slot="address-code-value" class="truncate font-mono text-body-sm font-medium tracking-wider">{code}</code>
  {
    href && (
      <a
        href={href}
        data-slot="address-code-link"
        aria-label={`${linkLabel} ${label.toLowerCase()} ${code}`}
        class="inline-flex h-11 shrink-0 items-center rounded-full px-3 text-body-sm font-medium text-primary no-underline outline-none hover:bg-muted focus-visible:ring-[3px] focus-visible:ring-ring/50"
      >
        {linkLabel}
      </a>
    )
  }
</span>

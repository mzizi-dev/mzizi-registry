---
/**
 * AddressSelector — "Deliver to": pick one of your saved addresses for a delivery, a
 * pickup or an event. A real radio group inside a `<fieldset>` with a `<legend>`, so it
 * works with no script, submits with its form, and is announced as one group.
 *
 * Each option is a whole-row `<label>` at least 56px tall (the 44px touch floor with room
 * for two lines): the address's name, its line, and its Kweli code in the mono face. The
 * chosen row is outlined in `--primary` and its radio is checked, so the choice is never
 * colour alone. A private address says so in words. With no saved addresses the group
 * says so and offers the add link instead of an empty box.
 *
 * Colour is semantic only, so Kweli's overlay (malachite) is the selection colour. The
 * React build is `address-selector.tsx`; both keep `contracts/ui/address-selector`.
 */
import { cn } from "./ui-utils";

export interface AddressOption {
  /** Submitted as the field's value. */
  id: string;
  /** "Home", "Shop", "Mum's place". */
  label: string;
  /** A line a courier can read: "12 Moyo Rd, Strathaven, Harare". */
  line?: string;
  /** The Kweli address code. */
  code?: string;
  /** A private or link-only address is marked in words. */
  visibility?: "public" | "link" | "private";
}

interface Props {
  /** The form field name. */
  name?: string;
  legend?: string;
  addresses: AddressOption[];
  /** The id of the chosen address. */
  value?: string;
  /** Where "Add an address" goes. */
  addHref?: string;
  addLabel?: string;
  class?: string;
}

const { name = "address", legend = "Deliver to", addresses, value, addHref, addLabel = "Add an address", class: className } = Astro.props;
const privacy = { private: "Private", link: "Link only", public: undefined } as const;
---

<fieldset
  data-slot="address-selector"
  data-portal="https://mzizi.dev/components/address-selector"
  class={cn("flex w-full min-w-0 flex-col gap-2 border-0 p-0", className)}
>
  <legend class="mb-2 text-body-sm font-semibold text-foreground">{legend}</legend>
  {
    addresses.length === 0 && (
      <p data-slot="address-selector-empty" class="text-body-sm text-muted-foreground">
        No saved addresses yet.
      </p>
    )
  }
  {
    addresses.map((a) => (
      <label
        data-slot="address-option"
        class="flex min-h-14 cursor-pointer items-center gap-3 rounded-lg border border-border bg-card px-4 py-3 text-foreground transition-colors hover:bg-muted has-[:checked]:border-primary has-[:focus-visible]:ring-[3px] has-[:focus-visible]:ring-ring/50"
      >
        <input type="radio" name={name} value={a.id} checked={a.id === value} class="size-5 shrink-0 accent-primary outline-none" />
        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
          <span class="flex items-center gap-2">
            <span class="truncate text-body-sm font-medium">{a.label}</span>
            {a.visibility && privacy[a.visibility] && <span data-slot="address-option-privacy" class="shrink-0 text-caption text-muted-foreground">{privacy[a.visibility]}</span>}
          </span>
          {a.line && <span class="truncate text-caption text-muted-foreground">{a.line}</span>}
        </span>
        {a.code && <code data-slot="address-option-code" class="shrink-0 font-mono text-caption tracking-wider text-muted-foreground">{a.code}</code>}
      </label>
    ))
  }
  {
    addHref && (
      <a
        href={addHref}
        data-slot="address-selector-add"
        class="inline-flex min-h-11 items-center self-start rounded-full px-3 text-body-sm font-medium text-primary no-underline outline-none hover:bg-muted focus-visible:ring-[3px] focus-visible:ring-ring/50"
      >
        {addLabel}
      </a>
    )
  }
</fieldset>

---
/**
 * AddressPrivateRow — one of your own private addresses in a list: a lock, the address's
 * name, its Kweli code in the mono face, who can open it, and a link to manage it.
 *
 * Kweli Address (RFC v0.1): person and home addresses are private by default. `private`
 * resolves for no one but the owner; `link` resolves for whoever holds the share link,
 * and is never indexed or shown on the public map. The row writes that out ("Private",
 * "Link only") rather than leaving it to the lock icon or a colour, and `detail` can add
 * what the owner needs ("Opened 3 times this week"). The manage link's accessible name
 * names the address, so a list of rows is not a list of identical "Manage" links.
 *
 * Colour is semantic only. The React build is `address-private-row.tsx`; both keep
 * `contracts/ui/address-private-row`.
 */
import { cn } from "./ui-utils";

interface Props {
  /** "Home", "Mum's place". */
  label: string;
  /** The Kweli address code. */
  code: string;
  /** Who can open it. */
  visibility?: "private" | "link";
  /** A line under the code: "Opened 3 times this week". */
  detail?: string;
  /** Where the owner manages it. */
  href?: string;
  linkLabel?: string;
  class?: string;
}

const { label, code, visibility = "private", detail, href, linkLabel = "Manage", class: className } = Astro.props;
const who = visibility === "link" ? "Link only" : "Private";
---

<div
  data-slot="address-private-row"
  data-portal="https://mzizi.dev/components/address-private-row"
  data-visibility={visibility}
  class={cn("flex min-h-14 w-full min-w-0 items-center gap-3 rounded-lg border border-border bg-card px-4 py-3 text-foreground", className)}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="size-5 shrink-0 text-muted-foreground"
  ><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
  <span class="flex min-w-0 flex-1 flex-col gap-0.5">
    <span class="flex items-center gap-2">
      <span class="truncate text-body-sm font-medium">{label}</span>
      <span data-slot="address-private-row-visibility" class="shrink-0 text-caption text-muted-foreground">{who}</span>
    </span>
    <code data-slot="address-private-row-code" class="truncate font-mono text-caption tracking-wider text-muted-foreground">{code}</code>
    {detail && <span data-slot="address-private-row-detail" class="truncate text-caption text-muted-foreground">{detail}</span>}
  </span>
  {
    href && (
      <a
        href={href}
        data-slot="address-private-row-link"
        aria-label={`${linkLabel} ${label}`}
        class="inline-flex min-h-11 shrink-0 items-center rounded-full px-3 text-body-sm font-medium text-primary no-underline outline-none hover:bg-muted focus-visible:ring-[3px] focus-visible:ring-ring/50"
      >
        {linkLabel}
      </a>
    )
  }
</div>

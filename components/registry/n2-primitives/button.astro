---
/**
 * Button — the registry primitive (`contracts/ui/button`), pure Astro, unstyled (#708).
 *
 * A <button> that carries structure, state and ARIA only: data-slot, data-variant,
 * data-size, data-state. It sets no class. The look is styles/pattern/mzizi-theme.css,
 * the identity-neutral minimums are styles/pattern/floor.css, and both read the values in
 * styles/pattern/tokens.css. `class` is a pass-through for the adopter's own classes.
 */

type Variant = "default" | "outline" | "secondary" | "ghost" | "destructive" | "link";
type Size = "default" | "sm" | "lg" | "icon" | "icon-sm";

interface Props {
  variant?: Variant;
  size?: Size;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
}
const { variant = "default", size = "default", type, disabled, class: extra } = Astro.props;
---

<button
  data-slot="button"
  data-portal="https://mzizi.dev/components/button"
  data-variant={variant}
  data-size={size}
  data-state={disabled ? "disabled" : "enabled"}
  type={type}
  disabled={disabled}
  class={extra}
><slot /></button>

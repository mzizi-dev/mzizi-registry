---
/**
 * MarkdownRenderer — the registry primitive (`contracts/ui/markdown-renderer`), pure Astro.
 *
 * Safe by construction: `./markdown-parse` reads the Markdown into a typed tree and this
 * file draws it as elements, so text is always a text node Astro escapes and an address is
 * always an escaped attribute. No `set:html` anywhere. Raw HTML in the source shows as text;
 * links pass an allow-list of schemes, and a refused link keeps its words. `markdown-renderer.tsx`
 * (React) and `markdown-renderer.rs` (Rust) draw the same tree with the same classes.
 *
 * The tree is drawn by plain recursive template functions (`inlines`, `lines`, `list`,
 * `blocks`) in one template expression, never through an HTML string, and never through a
 * component instance per node.
 */
import { cn } from "./ui-utils";
import {
  MARKDOWN_CLASSES as C,
  cellClass,
  headingTag,
  isExternal,
  markdownBlocks,
  type MarkdownBlock,
  type MarkdownInline,
  type MarkdownList,
  type MarkdownLinkPolicy,
  type MarkdownSource,
} from "./markdown-parse";

interface Props {
  content: string;
  links?: MarkdownLinkPolicy;
  from?: MarkdownSource;
  headingBase?: number;
  class?: string;
}

const {
  content = "",
  links = "safe",
  from = "markdown",
  headingBase = 1,
  class: extra,
} = Astro.props;

const tree = markdownBlocks(content, { links, from });
---

<div
  data-slot="markdown-renderer"
  data-portal="https://mzizi.dev/components/markdown-renderer"
  class={cn(C.root, extra)}
>{
  (() => {
    const inlines = (c: MarkdownInline[]): unknown[] =>
      c.map((x) =>
        x.t === "text" ? x.v
        : x.t === "code" ? <code class={C.code}>{x.v}</code>
        : x.t === "strong" ? <strong>{inlines(x.c)}</strong>
        : x.t === "em" ? <em>{inlines(x.c)}</em>
        : isExternal(x.href) ? <a href={x.href} class={C.a} target="_blank" rel="noopener noreferrer">{inlines(x.c)}</a>
        : <a href={x.href} class={C.a}>{inlines(x.c)}</a>
      );
    const lines = (ls: MarkdownInline[][]): unknown[] =>
      ls.map((l, j) => <Fragment>{j > 0 && <br />}{inlines(l)}</Fragment>);
    const list = (l: MarkdownList, nested: boolean): unknown => {
      const items = l.items.map((it) => <li>{lines(it.lines)}{it.children.map((sub) => list(sub, true))}</li>);
      return l.kind === "ol"
        ? <ol class={cn(C.ol, nested && C.nested)} start={l.start === 1 ? undefined : l.start}>{items}</ol>
        : <ul class={cn(C.ul, nested && C.nested)}>{items}</ul>;
    };
    const blocks = (bs: MarkdownBlock[]): unknown[] =>
      bs.map((b) => {
        if (b.kind === "p") return <p class={C.p}>{lines(b.lines)}</p>;
        if (b.kind === "h") {
          const Tag = headingTag(b.level, headingBase);
          return <Tag class={C[Tag]}>{inlines(b.c)}</Tag>;
        }
        if (b.kind === "ul" || b.kind === "ol") return list(b, false);
        if (b.kind === "quote") return <blockquote class={C.quote}>{blocks(b.children)}</blockquote>;
        if (b.kind === "code") return <pre class={C.pre}><code data-language={b.lang || undefined}>{b.v}</code></pre>;
        if (b.kind === "hr") return <hr class={C.hr} />;
        return (
          <div class={C.tableWrap}><table class={C.table}><thead><tr>{b.head.map((cell, k) => (<th scope="col" class={cellClass("th", b.align[k] ?? null)}>{inlines(cell)}</th>))}</tr></thead><tbody>{b.rows.map((row) => (<tr>{row.map((cell, k) => (<td class={cellClass("td", b.align[k] ?? null)}>{inlines(cell)}</td>))}</tr>))}</tbody></table></div>
        );
      });
    return blocks(tree);
  })()
}</div>

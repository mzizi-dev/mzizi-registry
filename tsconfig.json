{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/brand/*": ["./components/layout/*"],
      "@/components/ui/*": [
        "./components/ui/*",
        "./components/registry/n2-primitives/*",
        "./components/registry/n3-brand/*",
        "./components/registry/n7-shell/*"
      ],
      "@/hooks/*": ["./hooks/*", "./components/registry/n2-primitives/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    "components/registry/n10-documentation/nyuchi-docs-api.ts"
  ]
}

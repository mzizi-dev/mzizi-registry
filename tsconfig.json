{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"],
      "@/components/brand/*": ["./components/layout/*"],
      "@/components/ui/*": [
        "./components/ui/*",
        "./components/registry/n2-primitives/*",
        "./components/registry/n3-brand/*",
        "./components/registry/n7-shell/*"
      ],
      "@/hooks/*": ["./hooks/*", "./components/registry/n2-primitives/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "components/registry/n10-documentation/mzizi-docs-api.ts"
  ]
}

        "fallbacks": [{ "name": "cache", "durationMs": 5, "value": "cached" }]
      },
      "operation": { "durationMs": 20, "value": "fresh" },
      "schedule": [],
      "calls": [
        {
          "at": 0,
          "expect": {
            "served": "primary",
            "value": "fresh",
            "attempts": 1,
            "circuitState": "closed",
            "health": "healthy",
            "errorCount": 0,
            "lastErrorCode": null,
            "now": 20
          }
        },
        {
          "at": 20,
          "expect": {
            "served": "cache",
            "value": "cached",
            "attempts": 1,
            "circuitState": "closed",
            "health": "degraded",
            "errorCount": 1,
            "lastErrorCode": "rate-limited",
            "now": 25
          }
        },
        {
          "at": 1000,
          "expect": {
            "served": "primary",
            "value": "fresh",
            "attempts": 1,
            "circuitState": "closed",
            "health": "healthy",
            "errorCount": 1,
            "lastErrorCode": "rate-limited",
            "now": 1020
          }
        }
      ]
    }
  ],

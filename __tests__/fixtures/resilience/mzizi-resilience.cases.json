            "served": "primary",
            "value": "fresh",
            "attempts": 1,
            "circuitState": "closed",
            "health": "healthy",
            "errorCount": 2,
            "lastErrorCode": "circuit-open",
            "now": 1020
          }
        }
      ]
    },
    {

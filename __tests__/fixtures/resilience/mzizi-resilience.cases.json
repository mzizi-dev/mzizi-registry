    },
    {
      "name": "no fallback: the error surfaces and health is error",
      "config": {
        "name": "ledger",
        "timeoutMs": 100,
        "retry": {
          "maxAttempts": 1,
          "baseDelayMs": 10,
          "maxDelayMs": 10,
          "jitter": "none"
        },
        "circuitBreaker": {
          "failureThreshold": 1,
          "windowMs": 10000,
          "cooldownMs": 1000,
          "halfOpenMaxCalls": 1
        },
        "fallbacks": []

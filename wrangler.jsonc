{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mzizi-registry",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-22",

  // `nodejs_compat` is required by OpenNext: the Next.js server it wraps uses
  // Node built-ins. `global_fetch_strictly_public` makes the Worker's own fetch
  // behave like a browser's — a request to this Worker's own hostname goes back
  // out through the edge rather than short-circuiting internally, which is what
  // Next expects when a route fetches an absolute URL on the same origin.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Next's static output. `.open-next/assets` holds /_next/static and public/,
  // served straight from the edge without waking the Worker.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // The apex. A custom-domain route takes a BARE HOSTNAME — no `/*`, no
  // `zone_name`. Workers Builds previews upload a version WITHOUT applying
  // routes, so a malformed route here reads green on a PR and red on the
  // production deploy; that form has already broken two Workers in this org.
  //
  // This REPLACES the Cloudflare-proxied A record that pointed mzizi.dev at
  // Vercel. Rollback is to delete this block, redeploy, and restore that record.
  "routes": [
    { "pattern": "mzizi.dev", "custom_domain": true }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

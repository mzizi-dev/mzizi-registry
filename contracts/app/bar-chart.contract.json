{
  "$schema": "../schema/component-contract.schema.json",
  "name": "app/bar-chart",
  "title": "BarChart",
  "version": "1.1.0",
  "node": 6,
  "kind": "pattern",
  "summary": "A bar chart rendered on the server as plain HTML: columns over time or labelled rows, the exact figures in a real table under \"Show the figures\", following the theme through tokens.",
  "implementations": {
    "astro": {
      "registry": "app-bar-chart",
      "package": "@bundu/ui",
      "export": "@bundu/ui/app/BarChart.astro",
      "since": "0.3.0"
    },
    "tsx": { "registry": "app-bar-chart", "identity": "contract" },
    "rs": null,
    "related": ["chart"]
  },
  "props": [
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "The chart's heading (<h3>)."
    },
    {
      "name": "caption",
      "type": "string",
      "required": true,
      "description": "One sentence: what is counted, over what range."
    },
    {
      "name": "data",
      "type": "{ label: string; value: number; long?: string }[]",
      "required": true,
      "description": "The points; `long` is the table's label."
    },
    {
      "name": "layout",
      "type": "\"columns\" | \"rows\"",
      "required": false,
      "default": "columns",
      "values": ["columns", "rows"],
      "description": "Columns along the bottom, or one labelled bar per row."
    },
    {
      "name": "valueLabel",
      "type": "string",
      "required": false,
      "default": "Count",
      "description": "The figures table's value header."
    },
    {
      "name": "labelHeading",
      "type": "string",
      "required": false,
      "default": "Label",
      "description": "The figures table's label header."
    },
    {
      "name": "id",
      "type": "string",
      "required": false,
      "default": "chart",
      "description": "Prefix for the title id."
    },
    {
      "name": "locale",
      "type": "string",
      "required": false,
      "default": "en-GB",
      "description": "BCP 47 locale for numbers."
    }
  ],
  "slots": [],
  "behaviour": [
    "The bars are aria-hidden; the figures table (with a total) is the accessible version.",
    "No data or all zero: \"Nothing to chart in this range.\"",
    "Axis labels (columns) are thinned so they never crowd: always the first and the last, never one crowding the last; at most 6 from sm up, and below sm only the first, the middle (with at least 5 points) and the last.",
    "Bar sizes are SVG geometry (a <rect>'s height or width in a 0–100 viewBox), never inline styles: a CSP needs no style-src-attr 'unsafe-inline'."
  ],
  "states": {
    "default": {
      "props": {
        "title": "Sign-ups",
        "caption": "Per day, last 3 days",
        "data": [
          {
            "label": "Mon",
            "value": 3
          },
          {
            "label": "Tue",
            "value": 0
          },
          {
            "label": "Wed",
            "value": 5
          }
        ]
      }
    },
    "rows": {
      "props": {
        "title": "By role",
        "caption": "Now",
        "layout": "rows",
        "data": [
          {
            "label": "Admin",
            "value": 2
          }
        ]
      }
    },
    "long": {
      "description": "Twelve points: six axis labels from sm up, three on a phone.",
      "props": {
        "title": "Sign-ups",
        "caption": "Per day, last 12 days",
        "data": [
          {
            "label": "D1",
            "value": 4
          },
          {
            "label": "D2",
            "value": 7
          },
          {
            "label": "D3",
            "value": 2
          },
          {
            "label": "D4",
            "value": 9
          },
          {
            "label": "D5",
            "value": 5
          },
          {
            "label": "D6",
            "value": 3
          },
          {
            "label": "D7",
            "value": 8
          },
          {
            "label": "D8",
            "value": 6
          },
          {
            "label": "D9",
            "value": 1
          },
          {
            "label": "D10",
            "value": 7
          },
          {
            "label": "D11",
            "value": 4
          },
          {
            "label": "D12",
            "value": 10
          }
        ]
      }
    },
    "empty": {
      "props": {
        "title": "Sign-ups",
        "caption": "None",
        "data": []
      }
    }
  },
  "accessibility": {
    "roles": ["figure (aria-labelledby the title)", "table (figures)"],
    "keyboard": ["Enter/Space on \"Show the figures\"."],
    "focus": ["Default."],
    "aria": ["Bars aria-hidden; the table has a caption."],
    "wcag": ["1.1.1", "1.3.1", "1.4.1", "1.4.10"]
  },
  "density": [
    {
      "part": "figures disclosure",
      "select": "summary",
      "fine": 44,
      "coarse": 44
    }
  ],
  "theming": {
    "tokens": [
      "--background",
      "--foreground",
      "--border",
      "--muted",
      "--muted-foreground",
      "--ring",
      "--card",
      "--card-foreground",
      "--primary"
    ],
    "brandOverlay": "Bars are `--primary`, so they wear the brand mineral; the layout is identical.",
    "statusColours": []
  },
  "noJs": {
    "script": "none",
    "without": "Everything: the component is server-rendered HTML with no script."
  },
  "responsive": [
    "Scales from 320px to 1920px without distorting text; the plot is 12rem tall, 14rem from sm.",
    "Axis labels: at most 6 from sm up; first, middle and last below sm."
  ],
  "contract": "contract\n  slot is \"bar-chart\"\n  summary \"Show the figures\" min_height 44\n  when default shows h3 \"Sign-ups\"\n  when empty shows p \"Nothing to chart in this range.\"\n  when rows shows th \"Admin\"\nend",
  "checks": [
    {
      "say": "Labelled figure.",
      "select": "figure[aria-labelledby=\"chart-title\"]",
      "count": 1
    },
    {
      "say": "Bars are hidden from screen readers.",
      "select": "figure > [aria-hidden=\"true\"]",
      "count": 1
    },
    {
      "say": "Every value is in the table, with a total.",
      "select": "tbody tr",
      "count": 3
    },
    {
      "say": "Total row.",
      "select": "tfoot th",
      "count": 1,
      "text": "Total"
    },
    {
      "say": "On a phone, twelve points show three axis labels.",
      "state": "long",
      "select": "[data-axis] span:not(.hidden)",
      "count": 3
    },
    {
      "say": "From sm up, twelve points show six axis labels.",
      "state": "long",
      "select": "[data-axis] span:not([class~=\"sm:hidden\"])",
      "count": 6
    },
    {
      "say": "The first label is always shown.",
      "state": "long",
      "select": "[data-axis] > div:first-child > span:not(.hidden)",
      "count": 1,
      "text": "D1"
    },
    {
      "say": "The middle label is shown on a phone.",
      "state": "long",
      "select": "[data-axis] > div:nth-child(7) > span:not(.hidden)",
      "count": 1,
      "text": "D7"
    },
    {
      "say": "The last label is always shown.",
      "state": "long",
      "select": "[data-axis] > div:last-child > span:not(.hidden)",
      "count": 1,
      "text": "D12"
    }
  ]
}
